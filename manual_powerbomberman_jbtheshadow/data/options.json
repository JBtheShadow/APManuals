{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "_core": {
        "goal":{
            "_comment": [
                "Using 'goal' as the name of an option let you override some of the generated goal parameters"
            ],
            "display_name": "The End Objective",
            "description": "How to End your Randomized playthrough.",
            "aliases": {"easiest": 0},
            "hidden": false
        },
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 20
            }
        }
    },
    "user": {
        "tag": {
            "description": [
                "Enables tag matches", "This may allow for some locations involving tag matches"
            ],
            "type": "Toggle", "default": false, "group": "Battle Modes"
        },
        "reversi": {
            "description": [
                "Enables Reversi Battle mode", "This may allow for Reversi Battle locations"
            ],
            "type": "Toggle", "default": false, "group": "Battle Modes"
        },
        "dodge": {
            "description": [
                "Enables Dodge Battle mode", "This may allow for Dodge Battle locations"
            ],
            "type": "Toggle", "default": false, "group": "Battle Modes"
        },
        "hyper": {
            "description": [
                "Enables Hyper Battle mode", "This may allow for Hyper Battle locations"
            ],
            "type": "Toggle", "default": false, "group": "Battle Modes"
        },
        "king": {
            "description": [
                "Enables King Battle mode", "This may allow for King Battle locations"
            ],
            "type": "Toggle", "default": false, "group": "Battle Modes"
        },
        "royale": {
            "description": [
                "Enables Battle Royale mode", "This may allow for Battle Royale locations"
            ],
            "type": "Toggle", "default": false, "group": "Battle Modes"
        },
        "min_difficulty": {
            "description": [
                "Minimum COM difficulty", "Sets the minimum difficulty for battle locations",
                "Possible options are 1 (easy), 2 (normal), 3 (hard) and 4 (intense)"
            ],
            "type": "Choice", "default": 2, "group": "Battle Options",
            "values": { "easy": 1, "normal": 2, "hard": 3, "intense": 4 },
            "allow_custom_value": false
        },
        "max_difficulty": {
            "description": [
                "Maximum COM difficulty", "Sets the maximum difficulty for battle locations",
                "Possible options are 1 (easy), 2 (normal), 3 (hard) and 4 (intense)",
                "Cannot go lower than min difficulty"
            ],
            "type": "Choice", "default": 2, "group": "Battle Options",
            "values": { "easy": 1, "normal": 2, "hard": 3, "intense": 4 },
            "allow_custom_value": false
        },
        "min_players": {
            "description": [
                "Minimum player amount", "Sets the minimum amount of players for battle locations",
                "Ranges from 2 to 12"
            ],
            "type": "Range", "default": 6, "group": "Battle Options",
            "range_start": 2, "range_end": 12,
            "values": { "min": 2, "default": 6, "max_standard": 8, "max_wide": 12 }
        },
        "max_players": {
            "description": [
                "Maximum player amount", "Sets the maximum amount of players for battle locations",
                "Ranges from 2 to 12", "Cannot go lower than min players"
            ],
            "type": "Range", "default": 6, "group": "Battle Options",
            "range_start": 2, "range_end": 12,
            "values": { "min": 2, "default": 6, "max_standard": 8, "max_wide": 12 }
        },
        "min_matches": {
            "description": [
                "Minimum matches amount", "Sets the minimum amount of matches for battle locations",
                "Ranges from 1 to 5"
            ],
            "type": "Range", "default": 3, "group": "Battle Options",
            "range_start": 1, "range_end": 5,
            "values": { "min": 1, "default": 3, "max": 5 }
        },
        "max_matches": {
            "description": [
                "Maximum matches amount", "Sets the maximum amount of matches for battle locations",
                "Ranges from 1 to 5", "Cannot go lower than min matches"
            ],
            "type": "Range", "default": 3, "group": "Battle Options",
            "range_start": 1, "range_end": 5,
            "values": { "min": 1, "default": 3, "max": 5 }
        },
        "wide": {
            "description": [
                "Enables wide maps", "This may allow for some Survival Battle locations involving wide maps"
            ],
            "type": "Toggle", "default": false, "group": "Battle Options"
        },
        "score": {
            "description": [
                "Enables Score mode", "Adds locations related to Score Mode",
                "Possible options are 0 (none), 1 (classic), 2 (turbo) and 3 (both)"
            ],
            "type": "Choice", "default": 0, "group": "Extra Options",
            "values": { "none": 0, "classic": 1, "turbo": 2, "both": 3 },
            "allow_custom_value": false
        },
        "online": {
            "description": [
                "Enables Online mode",
                "There are a few items, like Invisibility or the Blast Lens, that are only included in online battles"
            ],
            "type": "Toggle", "default": false, "group": "Extra Options"
        },
        "louies": {
            "description": [
                "Enables Louies", "Adds locations related to each of the Louies"
            ],
            "type": "Toggle", "default": true, "group": "Extra Options"
        },
        "traps": {
            "description": [
                "Enables traps", "This includes Bomb Down, Fire Down, Geta, Salt Bomb and all of the skulls"
            ],
            "type": "Toggle", "default": true, "group": "Extra Options"
        }
    }
}